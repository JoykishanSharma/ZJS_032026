managed implementation in class ZJSBP_R_00FLIGHT unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZJSR_00FLIGHT alias Flight
persistent table ZJSA00FLIGHT
extensible
draft table ZJS00FLIGHT_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly )
   UUID,
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  field ( numbering : managed )
   UUID;


  create;
  update;
  delete;

  field ( readonly )
  City,
  CountryCode;

  validation validateEmail on save { create; field email; }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZJSA00FLIGHT corresponding extensible
  {
    UUID = UUID;
    AgencyID = AGENCY_ID;
    Name = NAME;
    Street = STREET;
    City = CITY;
    CountryCode = COUNTRY_CODE;
    Email = EMAIL;
    Phone = PHONE;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

}